# LOCAL DEVELOPMENT ONLY. Replace all passwords for shared deployments.
# These endpoints target host development. Compose overrides DATABASE_URL,
# REDIS_URL and S3_ENDPOINT with its internal service DNS names.
# Optional host-only NODE_ENV defaults to development; container images set
# production. Leave it unset here to preserve the images' production value.
# NODE_ENV=development

# PostgreSQL credentials and required API/bridge database connection.
# URL-encode special characters when constructing DATABASE_URL.
POSTGRES_USER=imageapp
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_DB=imageapp
DATABASE_URL=postgresql://imageapp:local-postgres-change-me@localhost:5432/imageapp
REDIS_URL=redis://localhost:6379

# MinIO server credentials. The local Compose stack uses these for its S3 client;
# host development uses S3_ACCESS_KEY/S3_SECRET_KEY, which must match locally.
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-minio-change-me
S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint used when signing URLs; never rewrite a signed URL.
# Optional: falls back to S3_ENDPOINT when omitted.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=localminio
S3_SECRET_KEY=local-minio-change-me
S3_ORIGINAL_BUCKET=originals
S3_OUTPUT_BUCKET=processed

# API listen port (1-65535) and comma-separated allowed browser origins.
# Compose publishes a fixed host port 3000 and explicitly sets container PORT=3000.
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Positive integer limits: upload MB 1-25, decoded/output pixels, concurrency 1-8,
# total queue attempts 1-10, processing timeout 1-300000 ms, retention 1-365 days.
# Increasing file/pixel/concurrency limits requires corresponding memory capacity.
# Above the default 10 MB/file, review Nginx/Ingress request-body limits for batches.
# If timeout exceeds the shutdown grace period, also adjust Compose/Kubernetes grace.
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
WORKER_CONCURRENCY=1
JOB_ATTEMPTS=3
PROCESS_TIMEOUT_MS=60000
RETENTION_DAYS=7
# Host development: use the absolute .venv/Scripts/python.exe path on Windows.
# Compose overrides this with the Python installed in its combined worker image.
PYTHON_BIN=python

# Required when enabling the monitoring profile; Grafana username is admin.
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me

# Optional development/verification settings below are examples to set in the
# invoking PowerShell session, e.g. $env:LIVE_E2E='1'. Vite, Playwright and kubectl
# do not automatically load these root .env comments. Do not expose server secrets
# through VITE_* variables.
# API_PROXY_TARGET=http://localhost:3000
# BASE_URL=http://localhost:8080
# LIVE_E2E=1
# API_URL=http://localhost:3000/api/v1
# JOBS=30
# SMOKE_FAILURES=1
# CRASH_WORKER=1
# DEMO_JOBS=24
# PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3002
# KUBECONFIG=.local/kubeconfig

# Optional MinIO Docker build argument (pass with --build-arg, not a runtime env):
# GO_SUMDB=sum.golang.org
# A reachable signed-checksum mirror can be supplied as documented in DEPLOYMENT.md.
